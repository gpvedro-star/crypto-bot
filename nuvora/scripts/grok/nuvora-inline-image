#!/usr/bin/env bash
# nuvora-inline-image <content_id>
#
# Asks NUVORA to attach the one inline body photo to a draft that already has
# its hero (run nuvora-image first). The server builds the search query from
# the stored draft's inline_image_brief and picks the photo itself — never the
# hero's photo; the Pexels
# key never leaves the NUVORA server, and this script never prints the
# NUVORA_GROK_DRAFT_KEY.
#
# Reference implementation for the Grok computer. This file lives in the
# NUVORA repository for review and version control; install it wherever the
# other nuvora-* commands live (e.g. /workspace/bin/nuvora-inline-image) and make it
# executable. It is not run by NUVORA itself.
#
# Two calls, never more:
#   1. GET  .../inline-image     — read-only check. If the inline photo is already
#      attached, this alone tells us so and nothing further happens: no
#      Pexels search, no risk of a second attempt.
#   2. POST .../inline-image     — only if step 1 found nothing. The server
#      itself is also idempotent (a second POST on an already-attached draft
#      returns ALREADY_ATTACHED without touching Pexels), so this script
#      never asks it to regenerate — not even if a step's response body
#      turns out to be unparseable, which reports FAILED and stops rather
#      than guessing and calling POST anyway.
#
# Requires:
#   NUVORA_BASE_URL   defaults to https://nuvora-news.netlify.app
#   The draft key at /workspace/.secrets/nuvora-grok-draft-key (one line, no
#   trailing content). Override the path with NUVORA_GROK_DRAFT_KEY_FILE.
#
# Output — exactly these lines, nothing else. Never a credential, a prompt,
# or a raw response body:
#   HTTP <status of the call that produced this result>
#   content_id <content_id>
#   image_status <ATTACHED|ALREADY_ATTACHED|INLINE_IMAGE_MISSING|HERO_IMAGE_REQUIRED|IMAGE_LOOKUP_FAILED|PEXELS_NOT_CONFIGURED|NOT_DRAFT|FAILED>
#   inline_image_url <path, or ->
#   image_credit <credit line, or ->
#
# Exit 0 only for ATTACHED or ALREADY_ATTACHED.
set -euo pipefail

CONTENT_ID="${1:-}"
if [ -z "$CONTENT_ID" ]; then
  echo "usage: nuvora-inline-image <content_id>" >&2
  exit 2
fi

BASE_URL="${NUVORA_BASE_URL:-https://nuvora-news.netlify.app}"
KEY_FILE="${NUVORA_GROK_DRAFT_KEY_FILE:-/workspace/.secrets/nuvora-grok-draft-key}"

if [ ! -r "$KEY_FILE" ]; then
  echo "nuvora-inline-image: cannot read $KEY_FILE" >&2
  exit 2
fi
DRAFT_KEY="$(tr -d '\n\r' < "$KEY_FILE")"
if [ -z "$DRAFT_KEY" ]; then
  echo "nuvora-inline-image: $KEY_FILE is empty" >&2
  exit 2
fi

TMP_BODY="$(mktemp)"
TMP_HEADERS="$(mktemp)"
chmod 600 "$TMP_HEADERS"
trap 'rm -f "$TMP_BODY" "$TMP_HEADERS"' EXIT

# The key goes to curl through a private header file, not argv, so it never
# appears in the process list, a log line, or this script's output.
printf 'Authorization: Bearer %s\n' "$DRAFT_KEY" > "$TMP_HEADERS"
unset DRAFT_KEY

URL="${BASE_URL}/api/v1/editorial/articles/${CONTENT_ID}/inline-image"

# Every field this route reports is at the top level of the JSON body, under
# these exact names, on both success and failure — so one parser covers both
# calls below. "|| true": a field this response doesn't have is normal, and
# under pipefail a non-matching grep would otherwise abort the script before
# it could print anything (the bug that motivated this rewrite).
extract() {
  { grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$TMP_BODY" || true; } | head -1 | sed -E 's/.*"([^"]*)"$/\1/'
}
has_true() {
  grep -q "\"$1\"[[:space:]]*:[[:space:]]*true" "$TMP_BODY"
}

call() {
  curl -sS -o "$TMP_BODY" -w '%{http_code}' -X "$1" "$URL" -H "@${TMP_HEADERS}" --max-time 90
}

report() {
  # $1 = HTTP status of the call being reported. Missing/unparseable
  # image_status is reported as FAILED, never assumed to mean anything else.
  local http_status="$1" image_status inline_url image_credit
  image_status="$(extract image_status)"
  if [ -z "$image_status" ]; then
    if has_true success; then image_status="ATTACHED"; else image_status="FAILED"; fi
  fi
  inline_url="$(extract inline_image_url)"
  image_credit="$(extract image_credit)"
  echo "HTTP ${http_status}"
  echo "content_id ${CONTENT_ID}"
  echo "image_status ${image_status}"
  echo "inline_image_url ${inline_url:--}"
  echo "image_credit ${image_credit:--}"
  case "$image_status" in
    ATTACHED|ALREADY_ATTACHED) return 0 ;;
    *) return 1 ;;
  esac
}

# 1. Read-only check first. Nothing here can trigger a Pexels search.
GET_STATUS="$(call GET)"
if [ "$GET_STATUS" = "200" ] && grep -q '"image_status"[[:space:]]*:[[:space:]]*"ALREADY_ATTACHED"' "$TMP_BODY"; then
  report "$GET_STATUS"
  exit $?
fi

# GET found nothing attached (404) or hit its own error (any other status) —
# either way, fall through to the one call that can actually attach the inline photo.
# If GET returned 200 with a body we could not make sense of, stop here
# instead of guessing: that ambiguous case is never treated as "go generate".
if [ "$GET_STATUS" = "200" ]; then
  echo "nuvora-inline-image: unexpected 200 from GET that wasn't ALREADY_ATTACHED — stopping without a POST" >&2
  echo "HTTP ${GET_STATUS}"
  echo "content_id ${CONTENT_ID}"
  echo "image_status FAILED"
  echo "inline_image_url -"
  echo "image_credit -"
  exit 1
fi

POST_STATUS="$(call POST)"
report "$POST_STATUS"
