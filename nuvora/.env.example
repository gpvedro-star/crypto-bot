# Canonical origin for canonical tags, sitemap, robots, RSS and Open Graph.
# Set to the production domain (e.g. https://your-domain.example). On Netlify,
# the site's primary URL is used when this is unset.
NEXT_PUBLIC_SITE_URL=

# Public contact mailbox. Leave empty until a real, monitored address exists —
# contact and corrections pages say so plainly while it is unset.
NEXT_PUBLIC_NUVORA_CONTACT_EMAIL=

# Social profiles. Only configured handles are linked or declared in schema.
NEXT_PUBLIC_NUVORA_SOCIAL_X=
NEXT_PUBLIC_NUVORA_SOCIAL_FACEBOOK=
NEXT_PUBLIC_NUVORA_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_NUVORA_SOCIAL_LINKEDIN=
NEXT_PUBLIC_NUVORA_SOCIAL_YOUTUBE=

# Bearer token for the authenticated editorial API (/api/v1/editorial/*,
# /api/v1/analytics). Server-side only. Leave unset to disable the API (503).
NUVORA_EDITORIAL_API_KEY=

# Token for authenticated draft previews at /preview/articles/{content_id}.
# Separate from the API key so a reviewer can see a draft without gaining
# publishing rights. Server-side only. Unset means preview is off (404).
NUVORA_PREVIEW_TOKEN=

# Comma-separated hosts allowed to serve editorial images, e.g.
# "images.example.com,cdn.example.net". Images from any other host are dropped
# and the story falls back to placeholder art, so next/image is never asked to
# fetch an arbitrary origin. Read at build time as well as at runtime.
NUVORA_IMAGE_HOSTS=

# Newsletter provider hand-off. Server-side only. While unset, the signup form
# reports that signup is unavailable and stores nothing.
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_PROVIDER_KEY=
