# Public site URL used for canonical links, sitemaps and Open Graph
NEXT_PUBLIC_SITE_URL=https://nuvora.com

# Bearer token for the authenticated editorial API (/api/v1/editorial/*, /api/v1/analytics).
# Leave unset to disable the write API entirely.
NUVORA_EDITORIAL_API_KEY=

# Newsletter provider hand-off (optional). When unset, sign-ups are accepted without delivery.
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_PROVIDER_KEY=
