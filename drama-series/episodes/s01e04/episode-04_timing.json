 "captions": [
  {
   "start": 0.48,
   "end": 2.8,
   "text": "תכירו את חבר שלי, אלכס.",
   "emphasis": "אלכס."
  },
  {
   "start": 2.8,
   "end": 4.36,
   "text": "אלכס היה אחד הילדים",
   "emphasis": "אלכס"
  },
  {
   "start": 4.36,
   "end": 5.07,
   "text": "הכי חזקים",
   "emphasis": "חזקים"
  },
  {
   "start": 5.07,
   "end": 7.255,
   "text": "והכי איכותיים שפגשתי.",
   "emphasis": null
  },
  {
   "start": 7.255,
   "end": 8.29,
   "text": "תמיד היה הראשון",
   "emphasis": null
  },
  {
   "start": 8.29,
   "end": 9.535,
   "text": "לבוא לעזור.",
   "emphasis": "לעזור."
  },
  {
   "start": 9.535,
   "end": 10.42,
   "text": "הוא עבר גיבוש",
   "emphasis": "גיבוש"
  },
  {
   "start": 10.42,
   "end": 11.965,
   "text": "ליחידה סודית בצבא.",
   "emphasis": null
  },
  {
   "start": 11.965,
   "end": 13.79,
   "text": "כולם היו תופסים ממנו.",
   "emphasis": "תופסים"
  },
  {
   "start": 13.79,
   "end": 14.64,
   "text": "וכולם גם היו",
   "emphasis": null
  },
  {
   "start": 14.64,
   "end": 16.07,
   "text": "מפחדים ממנו.",
   "emphasis": "מפחדים"
  },
  {
   "start": 16.36,
   "end": 17.18,
   "text": "אני זוכר,",
   "emphasis": null
  },
  {
   "start": 17.18,
   "end": 17.99,
   "text": "כשאלכס חגג",
   "emphasis": null
  },
  {
   "start": 17.99,
   "end": 19.03,
   "text": "שמונה עשרה,",
   "emphasis": "שמונה"
  },
  {
   "start": 19.03,
   "end": 21.165,
   "text": "נסענו כל החברים לאילת.",
   "emphasis": "נסענו"
  },
  {
   "start": 21.165,
   "end": 22.02,
   "text": "גם לחגוג לו",
   "emphasis": null
  },
  {
   "start": 22.02,
   "end": 22.49,
   "text": "יום הולדת",
   "emphasis": "יום"
  },
  {
   "start": 22.49,
   "end": 23.64,
   "text": "וגם לחגוג איתו",
   "emphasis": null
  },
  {
   "start": 23.64,
   "end": 24.72,
   "text": "לפני הגיוס.",
   "emphasis": "הגיוס."
  },
  {
   "start": 24.72,
   "end": 25.63,
   "text": "ידענו שלא נראה",
   "emphasis": null
  },
  {
   "start": 25.63,
   "end": 26.565,
   "text": "אותו תקופה.",
   "emphasis": "תקופה."
  },
  {
   "start": 26.565,
   "end": 29.02,
   "text": "סגרנו וילה מטורפת באילת.",
   "emphasis": "מטורפת"
  },
  {
   "start": 29.02,
   "end": 30.57,
   "text": "הבאנו אוכל, שתייה,",
   "emphasis": null
  },
  {
   "start": 30.57,
   "end": 32.07,
   "text": "אלכוהול בהרמות",
   "emphasis": null
  },
  {
   "start": 32.07,
   "end": 33.43,
   "text": "וכמובן סמים.",
   "emphasis": "סמים."
  },
  {
   "start": 33.43,
   "end": 35.03,
   "text": "מלא סמים.",
   "emphasis": "סמים."
  },
  {
   "start": 35.07,
   "end": 35.89,
   "text": "בזמן שאנחנו",
   "emphasis": null
  },
  {
   "start": 35.89,
   "end": 37.015,
   "text": "חוגגים בווילה,",
   "emphasis": "בווילה,"
  },
  {
   "start": 37.015,
   "end": 37.92,
   "text": "קיבלתי טלפון",
   "emphasis": "קיבלתי"
  },
  {
   "start": 37.92,
   "end": 38.97,
   "text": "מאחד האנשים שלי",
   "emphasis": null
  },
  {
   "start": 38.97,
   "end": 40.425,
   "text": "מצפון תל אביב.",
   "emphasis": "מצפון"
  },
  {
   "start": 40.46,
   "end": 41.63,
   "text": "הוא ביקש שאני אעזור",
   "emphasis": null
  },
  {
   "start": 41.63,
   "end": 43.04,
   "text": "לחבר שלו באילת.",
   "emphasis": "באילת."
  },
  {
   "start": 43.04,
   "end": 44.54,
   "text": "כמובן שהסכמתי.",
   "emphasis": "שהסכמתי."
  },
  {
   "start": 44.54,
   "end": 45.32,
   "text": "עליתי על מונית",
   "emphasis": "מונית"
  },
  {
   "start": 45.32,
   "end": 46.78,
   "text": "ונסעתי אליו.",
   "emphasis": null
  },
  {
   "start": 47.62,
   "end": 48.67,
   "text": "הוא הכניס אותי",
   "emphasis": null
  },
  {
   "start": 48.67,
   "end": 49.78,
   "text": "לסוויטה מלכותית",
   "emphasis": "מלכותית"
  },
  {
   "start": 49.78,
   "end": 51.755,
   "text": "במלון הכי מפואר באילת.",
   "emphasis": "מפואר"
  },
  {
   "start": 51.755,
   "end": 52.68,
   "text": "שם הבנתי,",
   "emphasis": null
  },
  {
   "start": 52.68,
   "end": 53.91,
   "text": "בפעם הראשונה,",
   "emphasis": null
  },
  {
   "start": 53.91,
   "end": 55.68,
   "text": "מה זה עושר אמיתי.",
   "emphasis": "עושר"
  },
  {
   "start": 55.68,
   "end": 56.75,
   "text": "מה זה כמויות",
   "emphasis": null
  },
  {
   "start": 56.75,
   "end": 57.805,
   "text": "של כסף.",
   "emphasis": "כסף."
  },
  {
   "start": 57.805,
   "end": 58.87,
   "text": "הבחורות הכי יפות",
   "emphasis": null
  },
  {
   "start": 58.87,
   "end": 59.77,
   "text": "שראיתי ישבו",
   "emphasis": null
  },
  {
   "start": 59.77,
   "end": 60.45,
   "text": "בבגדי ים",
   "emphasis": null
  },
  {
   "start": 60.45,
   "end": 61.61,
   "text": "על כיסאות השיזוף",
   "emphasis": null
  },
  {
   "start": 61.61,
   "end": 62.47,
   "text": "במרפסת הענקית",
   "emphasis": "הענקית"
  },
  {
   "start": 62.47,
   "end": 64.39,
   "text": "שמשקיפה על כל הטיילת.",
   "emphasis": null
  },
  {
   "start": 64.39,
   "end": 65.73,
   "text": "בקבוקים של האלכוהול",
   "emphasis": null
  },
  {
   "start": 65.73,
   "end": 67.25,
   "text": "הכי יוקרתי שיש.",
   "emphasis": "יוקרתי"
  },
  {
   "start": 67.25,
   "end": 68.58,
   "text": "ביקשו ממני לעזור להם",
   "emphasis": null
  },
  {
   "start": 68.58,
   "end": 69.76,
   "text": "עם משהו לעשן.",
   "emphasis": "לעשן."
  },
  {
   "start": 69.76,
   "end": 71.47,
   "text": "כמובן שהסכמתי.",
   "emphasis": "שהסכמתי."
  },
  {
   "start": 73.56,
   "end": 74.45,
   "text": "ותוך כדי",
   "emphasis": null
  },
  {
   "start": 74.45,
   "end": 76.01,
   "text": "אני מקבל טלפון,",
   "emphasis": "טלפון,"
  },
  {
   "start": 76.01,
   "end": 77.45,
   "text": "מהחבר׳ה שלי.",
   "emphasis": null
  },
  {
   "start": 77.45,
   "end": 78.45,
   "text": "דין, בוא מהר!",
   "emphasis": null
  },
  {
   "start": 78.45,
   "end": 79.717,
   "text": "אלכס נרצח!",
   "emphasis": null
  },
  {
   "start": 79.717,
   "end": 80.665,
   "text": "באותו רגע",
   "emphasis": null
  },
  {
   "start": 80.665,
   "end": 82.377,
   "text": "ראיתי שחור.",
   "emphasis": "שחור."
  },
  {
   "start": 82.817,
   "end": 84.3,
   "text": "לא הבנתי.",
   "emphasis": "הבנתי."
  },
  {
   "start": 85.24,
   "end": 86.72,
   "text": "בזמן שהייתי במלון",
   "emphasis": null
  },
  {
   "start": 86.72,
   "end": 88.79,
   "text": "עם הבחורים מתל אביב,",
   "emphasis": "מתל"
  },
  {
   "start": 88.79,
   "end": 90.369,
   "text": "החבר׳ה שלי הסתכסכו",
   "emphasis": "הסתכסכו"
  },
  {
   "start": 90.369,
   "end": 92.54,
   "text": "עם השכנים בווילה ליד.",
   "emphasis": null
  },
  {
   "start": 92.54,
   "end": 93.945,
   "text": "כשאלכס בא להרגיע",
   "emphasis": "להרגיע"
  },
  {
   "start": 93.945,
   "end": 95.39,
   "text": "את העניינים,",
   "emphasis": null
  },
  {
   "start": 95.39,
   "end": 96.271,
   "text": "אחד השכנים",
   "emphasis": null
  },
  {
   "start": 96.271,
   "end": 97.95,
   "text": "דקר אותו בלב.",
   "emphasis": "דקר"
  }
