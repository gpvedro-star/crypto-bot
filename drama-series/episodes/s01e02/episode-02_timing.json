 "captions": [
  {
   "start": 0.46,
   "end": 1.33,
   "text": "אני לא אשכח",
   "emphasis": "אשכח"
  },
  {
   "start": 1.33,
   "end": 2.905,
   "text": "את היום הזה לעולם.",
   "emphasis": "לעולם."
  },
  {
   "start": 2.905,
   "end": 3.8,
   "text": "טיילנו בעיר",
   "emphasis": null
  },
  {
   "start": 3.8,
   "end": 6.225,
   "text": "כל החבר׳ה, מסטולים בטירוף.",
   "emphasis": "מסטולים"
  },
  {
   "start": 6.225,
   "end": 7.595,
   "text": "לא מפסיקים לצחוק,",
   "emphasis": "לצחוק,"
  },
  {
   "start": 7.595,
   "end": 8.28,
   "text": "לא מבינים למה",
   "emphasis": null
  },
  {
   "start": 8.28,
   "end": 9.905,
   "text": "כולם מסתכלים עלינו.",
   "emphasis": "כולם"
  },
  {
   "start": 9.905,
   "end": 12.005,
   "text": "ובמקום להיות בבית ספר…",
   "emphasis": "ספר…"
  },
  {
   "start": 12.185,
   "end": 13.355,
   "text": "הלכנו לים.",
   "emphasis": "לים."
  },
  {
   "start": 13.355,
   "end": 14.115,
   "text": "בדרך עצרנו",
   "emphasis": null
  },
  {
   "start": 14.115,
   "end": 15.425,
   "text": "באיזו פיצוצייה",
   "emphasis": "פיצוצייה"
  },
  {
   "start": 15.425,
   "end": 17.215,
   "text": "וקנינו בקבוק וודקה.",
   "emphasis": "וודקה."
  },
  {
   "start": 17.215,
   "end": 18.53,
   "text": "שתינו את כולו.",
   "emphasis": "כולו."
  },
  {
   "start": 18.53,
   "end": 20.505,
   "text": "ככה, ישר מהבקבוק.",
   "emphasis": "מהבקבוק."
  },
  {
   "start": 20.505,
   "end": 21.955,
   "text": "אצלנו לא היה אקסל",
   "emphasis": "אקסל"
  },
  {
   "start": 21.955,
   "end": 24.055,
   "text": "ולא כל מיני ערבובים.",
   "emphasis": null
  },
  {
   "start": 24.095,
   "end": 24.965,
   "text": "אני לא אשכח",
   "emphasis": null
  },
  {
   "start": 24.965,
   "end": 26.365,
   "text": "איך שכבתי מסטול",
   "emphasis": "מסטול"
  },
  {
   "start": 26.365,
   "end": 28.005,
   "text": "בטירוף על החול.",
   "emphasis": "החול."
  },
  {
   "start": 28.005,
   "end": 29.935,
   "text": "כל העולם מסתובב לי.",
   "emphasis": "מסתובב"
  },
  {
   "start": 29.935,
   "end": 31.88,
   "text": "אני באפס דאגות.",
   "emphasis": "דאגות."
  },
  {
   "start": 31.88,
   "end": 32.835,
   "text": "אולי הבנאדם",
   "emphasis": null
  },
  {
   "start": 32.835,
   "end": 34.66,
   "text": "הכי מאושר בעולם.",
   "emphasis": "מאושר"
  },
  {
   "start": 35.0,
   "end": 37.125,
   "text": "בחזור הלכנו לשלב.",
   "emphasis": "לשלב."
  },
  {
   "start": 37.125,
   "end": 38.17,
   "text": "הייתה לו בחדר",
   "emphasis": null
  },
  {
   "start": 38.17,
   "end": 39.85,
   "text": "מיטת קומותיים זוגית.",
   "emphasis": "קומותיים"
  },
  {
   "start": 39.85,
   "end": 40.84,
   "text": "משהו שלא רואים",
   "emphasis": null
  },
  {
   "start": 40.84,
   "end": 42.265,
   "text": "היום בשום מקום.",
   "emphasis": "מקום."
  },
  {
   "start": 42.265,
   "end": 43.43,
   "text": "אצל שלב הבית",
   "emphasis": null
  },
  {
   "start": 43.43,
   "end": 45.025,
   "text": "תמיד היה ריק.",
   "emphasis": "ריק."
  },
  {
   "start": 45.025,
   "end": 46.805,
   "text": "אבא שלו חי בחו״ל.",
   "emphasis": "בחו״ל."
  },
  {
   "start": 46.805,
   "end": 48.28,
   "text": "אחותו הייתה כל היום",
   "emphasis": "אחותו"
  },
  {
   "start": 48.28,
   "end": 49.335,
   "text": "בחדר שלה.",
   "emphasis": null
  },
  {
   "start": 49.335,
   "end": 50.655,
   "text": "ואמא שלו?",
   "emphasis": "שלו?"
  },
  {
   "start": 50.865,
   "end": 51.85,
   "text": "רק אלוהים יודע",
   "emphasis": "אלוהים"
  },
  {
   "start": 51.85,
   "end": 52.965,
   "text": "איפה היא הייתה.",
   "emphasis": null
  },
  {
   "start": 52.965,
   "end": 54.735,
   "text": "נרדמנו על הקומותיים.",
   "emphasis": "נרדמנו"
  },
  {
   "start": 54.735,
   "end": 55.655,
   "text": "למזלי קמתי",
   "emphasis": null
  },
  {
   "start": 55.655,
   "end": 57.435,
   "text": "בסביבות שש בערב.",
   "emphasis": "שש"
  },
  {
   "start": 57.435,
   "end": 58.265,
   "text": "רצתי הביתה",
   "emphasis": "רצתי"
  },
  {
   "start": 58.265,
   "end": 59.935,
   "text": "כאילו לא קרה כלום.",
   "emphasis": "כלום."
  },
  {
   "start": 59.935,
   "end": 60.865,
   "text": "הספקתי להגיע",
   "emphasis": "הספקתי"
  },
  {
   "start": 60.865,
   "end": 61.875,
   "text": "לפני שההורים שלי",
   "emphasis": null
  },
  {
   "start": 61.875,
