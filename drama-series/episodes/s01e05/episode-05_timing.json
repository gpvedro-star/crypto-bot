 "captions": [
  {
   "start": 0.44,
   "end": 1.257,
   "text": "הגיע היום",
   "emphasis": null
  },
  {
   "start": 1.257,
   "end": 2.84,
   "text": "להתגייס לצבא.",
   "emphasis": "להתגייס"
  },
  {
   "start": 2.84,
   "end": 3.646,
   "text": "רציתי ממש",
   "emphasis": null
  },
  {
   "start": 3.646,
   "end": 5.2,
   "text": "ללכת לקרבי.",
   "emphasis": "לקרבי."
  },
  {
   "start": 5.49,
   "end": 6.394,
   "text": "בסוף הגעתי",
   "emphasis": null
  },
  {
   "start": 6.394,
   "end": 7.39,
   "text": "לקריה.",
   "emphasis": "לקריה."
  },
  {
   "start": 7.39,
   "end": 8.277,
   "text": "ומשם נפתחו",
   "emphasis": "נפתחו"
  },
  {
   "start": 8.277,
   "end": 9.65,
   "text": "לי החיים.",
   "emphasis": null
  },
  {
   "start": 9.99,
   "end": 10.71,
   "text": "כמות הבנות",
   "emphasis": "הבנות"
  },
  {
   "start": 10.71,
   "end": 12.04,
   "text": "והאנשים האיכותיים",
   "emphasis": null
  },
  {
   "start": 12.04,
   "end": 12.79,
   "text": "שהכרתי שם",
   "emphasis": null
  },
  {
   "start": 12.79,
   "end": 14.315,
   "text": "הייתה מטורפת.",
   "emphasis": "מטורפת."
  },
  {
   "start": 14.315,
   "end": 15.755,
   "text": "ובמקום למנף את זה,",
   "emphasis": "למנף"
  },
  {
   "start": 15.755,
   "end": 16.8,
   "text": "הפכתי את כולם",
   "emphasis": null
  },
  {
   "start": 16.8,
   "end": 18.15,
   "text": "למכורים לירוק.",
   "emphasis": "למכורים"
  },
  {
   "start": 18.15,
   "end": 18.88,
   "text": "פתחתי קו",
   "emphasis": "קו"
  },
  {
   "start": 18.88,
   "end": 19.68,
   "text": "בתוך הבסיס,",
   "emphasis": null
  },
  {
   "start": 19.68,
   "end": 20.38,
   "text": "ולא רציתי",
   "emphasis": null
  },
  {
   "start": 20.38,
   "end": 21.46,
   "text": "לצאת משם.",
   "emphasis": null
  },
  {
   "start": 21.46,
   "end": 22.42,
   "text": "כל היום היינו",
   "emphasis": null
  },
  {
   "start": 22.42,
   "end": 23.32,
   "text": "מעשנים בבסיס,",
   "emphasis": "מעשנים"
  },
  {
   "start": 23.32,
   "end": 24.49,
   "text": "ואני הייתי עושה",
   "emphasis": null
  },
  {
   "start": 24.49,
   "end": 25.86,
   "text": "כסף מטורף.",
   "emphasis": "כסף"
  },
  {
   "start": 27.8,
   "end": 29.26,
   "text": "ובערב הייתי יוצא",
   "emphasis": null
  },
  {
   "start": 29.26,
   "end": 30.48,
   "text": "לסבב מועדונים",
   "emphasis": "מועדונים"
  },
  {
   "start": 30.48,
   "end": 31.785,
   "text": "בתל אביב.",
   "emphasis": null
  },
  {
   "start": 31.785,
   "end": 32.76,
   "text": "זאת הייתה אחת",
   "emphasis": null
  },
  {
   "start": 32.76,
   "end": 33.6,
   "text": "התקופות היפות",
   "emphasis": "היפות"
  },
  {
   "start": 33.6,
   "end": 34.935,
   "text": "בחיים שלי.",
   "emphasis": null
  },
  {
   "start": 34.99,
   "end": 36.15,
   "text": "עד שהגיע הרגע",
   "emphasis": null
  },
  {
   "start": 36.15,
   "end": 37.66,
   "text": "ששינה הכול.",
   "emphasis": "ששינה"
  },
  {
   "start": 39.6,
   "end": 40.678,
   "text": "חזרתי ממסיבה",
   "emphasis": null
  },
  {
   "start": 40.678,
   "end": 41.403,
   "text": "בתל אביב",
   "emphasis": null
  },
  {
   "start": 41.403,
   "end": 42.481,
   "text": "והלכתי לישון",
   "emphasis": null
  },
  {
   "start": 42.481,
   "end": 44.36,
   "text": "אצל מישהי בעיר.",
   "emphasis": "מישהי"
  },
  {
   "start": 44.7,
   "end": 46.56,
   "text": "ולא קמתי לבסיס.",
   "emphasis": "ולא"
  },
  {
   "start": 46.7,
   "end": 47.726,
   "text": "המזל שלי היה",
   "emphasis": null
  },
  {
   "start": 47.726,
   "end": 48.613,
   "text": "שבאותו יום",
   "emphasis": null
  },
  {
   "start": 48.613,
   "end": 49.587,
   "text": "הייתה פשיטה",
   "emphasis": "פשיטה"
  },
  {
   "start": 49.587,
   "end": 50.8,
   "text": "על הבסיס,",
   "emphasis": null
  },
  {
   "start": 50.8,
   "end": 51.708,
   "text": "ועצרו את כל",
   "emphasis": null
  },
  {
   "start": 51.708,
   "end": 53.36,
   "text": "מי שהיה חשוד.",
   "emphasis": "חשוד."
  },
  {
   "start": 54.6,
   "end": 55.87,
   "text": "פתאום מצאתי את עצמי",
   "emphasis": null
  },
  {
   "start": 55.87,
   "end": 56.8,
   "text": "בלב תל אביב,",
   "emphasis": "בלב"
  },
  {
   "start": 56.8,
   "end": 57.78,
   "text": "המשטרה הצבאית",
   "emphasis": null
  },
  {
   "start": 57.78,
   "end": 58.87,
   "text": "מחפשת אותי בנרות,",
   "emphasis": "בנרות,"
  },
  {
   "start": 58.87,
   "end": 60.18,
   "text": "וכל החבר׳ה שלי",
   "emphasis": "החבר׳ה"
  },
  {
   "start": 60.18,
   "end": 62.1,
   "text": "מהצבא עצורים.",
   "emphasis": "עצורים."
  },
  {
   "start": 62.1,
   "end": 62.72,
   "text": "הלכתי זריז",
   "emphasis": null
  },
  {
   "start": 62.72,
   "end": 63.47,
   "text": "לביקור רופא",
   "emphasis": "רופא"
  },
  {
   "start": 63.47,
   "end": 64.85,
   "text": "והוצאתי גימלים.",
   "emphasis": "גימלים."
  },
  {
   "start": 64.85,
   "end": 65.67,
   "text": "משכתי את זה",
   "emphasis": null
  },
  {
   "start": 65.67,
   "end": 66.64,
   "text": "כמעט חודש.",
   "emphasis": "כמעט"
  },
  {
   "start": 66.64,
   "end": 67.46,
   "text": "הפסקתי לעשן",
   "emphasis": null
  },
  {
   "start": 67.46,
   "end": 69.05,
   "text": "כל התקופה הזאת.",
   "emphasis": null
  },
  {
   "start": 70.99,
   "end": 73.06,
   "text": "ואז חזרתי לבסיס.",
   "emphasis": "לבסיס."
  },
  {
   "start": 73.06,
   "end": 74.165,
   "text": "איך שנכנסתי,",
   "emphasis": null
  },
  {
   "start": 74.165,
   "end": 75.26,
   "text": "לא עברה חצי שעה",
   "emphasis": "לא"
  },
  {
   "start": 75.26,
   "end": 76.45,
   "text": "וקפצו עליי סמויים",
   "emphasis": "סמויים"
  },
  {
   "start": 76.45,
   "end": 78.03,
   "text": "של המשטרה הצבאית.",
   "emphasis": null
  },
  {
   "start": 78.03,
   "end": 79.08,
   "text": "חקירות של עשר",
   "emphasis": "עשר"
  },
  {
   "start": 79.08,
   "end": 80.16,
   "text": "עד שש עשרה שעות",
   "emphasis": "שש"
  },
  {
   "start": 80.16,
   "end": 81.52,
   "text": "בלי הפסקה.",
   "emphasis": "הפסקה."
  },
  {
   "start": 83.48,
   "end": 84.54,
   "text": "ובתכל׳ס,",
   "emphasis": null
  },
  {
   "start": 84.54,
   "end": 85.08,
   "text": "לא היה להם",
   "emphasis": null
  },
  {
   "start": 85.08,
   "end": 86.33,
   "text": "כלום עליי.",
   "emphasis": "כלום"
  },
  {
   "start": 88.47,
   "end": 90.47,
   "text": "אחרי עשרים וארבע שעות",
   "emphasis": "עשרים"
  },
  {
   "start": 90.47,
   "end": 92.07,
   "text": "שחררו אותי.",
   "emphasis": "שחררו"
  },
  {
   "start": 92.07,
   "end": 93.828,
   "text": "החלטתי לעשות הפסקה",
   "emphasis": "הפסקה"
  },
  {
   "start": 93.828,
   "end": 95.397,
   "text": "עד השחרור.",
   "emphasis": null
  },
  {
   "start": 97.737,
   "end": 98.997,
   "text": "אבל ביום השחרור",
   "emphasis": "השחרור"
  },
  {
   "start": 98.997,
   "end": 100.662,
   "text": "החלטתי שזהו.",
   "emphasis": "שזהו."
  },
  {
   "start": 100.662,
   "end": 102.047,
   "text": "עכשיו הגיע הזמן שלי",
   "emphasis": null
  },
  {
   "start": 102.047,
   "end": 103.672,
   "text": "להשתלט על התחום.",
   "emphasis": "להשתלט"
  }
 ],
