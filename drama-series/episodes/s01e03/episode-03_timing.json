   "start": 3.485,
   "end": 4.52,
   "text": "החלטתי שבא לי",
   "emphasis": null
  },
  {
   "start": 4.52,
   "end": 6.475,
   "text": "כל היום רק לעשן.",
   "emphasis": "לעשן."
  },
  {
   "start": 6.59,
   "end": 8.12,
   "text": "וזה מה שקרה.",
   "emphasis": "שקרה."
  },
  {
   "start": 8.37,
   "end": 8.84,
   "text": "בית ספר",
   "emphasis": null
  },
  {
   "start": 8.84,
   "end": 10.37,
   "text": "לא בא בחשבון.",
   "emphasis": "בחשבון."
  },
  {
   "start": 10.37,
   "end": 11.21,
   "text": "הייתי עובד",
   "emphasis": null
  },
  {
   "start": 11.21,
   "end": 12.205,
   "text": "בשתי עבודות,",
   "emphasis": "עבודות,"
  },
  {
   "start": 12.205,
   "end": 14.095,
   "text": "מהבוקר עד הערב.",
   "emphasis": "הערב."
  },
  {
   "start": 14.105,
   "end": 15.12,
   "text": "שליח פיצה",
   "emphasis": "שליח"
  },
  {
   "start": 15.12,
   "end": 16.77,
   "text": "ומוכר במכולת.",
   "emphasis": "במכולת."
  },
  {
   "start": 16.77,
   "end": 17.91,
   "text": "כסף?",
   "emphasis": "כסף?"
  },
  {
   "start": 17.915,
   "end": 19.13,
   "text": "לא הייתה בעיה.",
   "emphasis": "בעיה."
  },
  {
   "start": 19.13,
   "end": 20.97,
   "text": "היה לי המון כסף.",
   "emphasis": "המון"
  },
  {
   "start": 20.97,
   "end": 21.92,
   "text": "בגלל שעזבתי",
   "emphasis": null
  },
  {
   "start": 21.92,
   "end": 23.11,
   "text": "את בית הספר,",
   "emphasis": "הספר,"
  },
  {
   "start": 23.11,
   "end": 24.4,
   "text": "הייתי כל היום מסתובב",
   "emphasis": null
  },
  {
   "start": 24.4,
   "end": 26.1,
   "text": "עם אנשים מפוקפקים.",
   "emphasis": "מפוקפקים."
  },
  {
   "start": 26.16,
   "end": 27.38,
   "text": "מהמרים כל היום,",
   "emphasis": "מהמרים"
  },
  {
   "start": 27.38,
   "end": 29.13,
   "text": "עושים שודים קטנים.",
   "emphasis": "שודים"
  },
  {
   "start": 29.25,
   "end": 30.01,
   "text": "אז זה לא נראה לי",
   "emphasis": null
  },
  {
   "start": 30.01,
   "end": 31.28,
   "text": "כזה סיפור.",
   "emphasis": "סיפור."
  },
  {
   "start": 31.32,
   "end": 31.98,
   "text": "ואז חבר",
   "emphasis": null
  },
  {
   "start": 31.98,
   "end": 33.83,
   "text": "הכיר לי חבר׳ה שלו",
   "emphasis": null
  },
  {
   "start": 33.83,
   "end": 35.335,
   "text": "מצפון תל אביב.",
   "emphasis": "מצפון"
  },
  {
   "start": 35.335,
   "end": 35.98,
   "text": "הם שינו לי",
   "emphasis": null
  },
  {
   "start": 35.98,
   "end": 37.665,
   "text": "את החיים לגמרי.",
   "emphasis": "לגמרי."
  },
  {
   "start": 38.205,
   "end": 39.545,
   "text": "בדיוק באותה תקופה",
   "emphasis": null
  },
  {
   "start": 39.545,
   "end": 40.555,
   "text": "הוצאתי רישיון",
   "emphasis": "רישיון"
  },
  {
   "start": 40.555,
   "end": 41.185,
   "text": "וקניתי לי",
   "emphasis": null
  },
  {
   "start": 41.185,
   "end": 42.85,
   "text": "ב.מ.וו יפהפייה.",
   "emphasis": "ב.מ.וו"
  },
  {
   "start": 42.85,
   "end": 44.11,
   "text": "לא חדשה כל כך,",
   "emphasis": null
  },
  {
   "start": 44.11,
   "end": 45.83,
   "text": "אבל עשתה את העבודה.",
   "emphasis": "העבודה."
  },
  {
   "start": 46.17,
   "end": 47.41,
   "text": "והתחלתי להסתובב",
   "emphasis": null
  },
  {
   "start": 47.41,
   "end": 48.33,
   "text": "עם החבר׳ה האלה",
   "emphasis": null
  },
  {
   "start": 48.33,
   "end": 49.955,
   "text": "מצפון תל אביב.",
   "emphasis": "מצפון"
  },
  {
   "start": 49.955,
   "end": 50.8,
   "text": "הייתי מעביר להם",
   "emphasis": "מעביר"
  },
  {
   "start": 50.8,
   "end": 52.17,
   "text": "כמויות של גראס.",
   "emphasis": "גראס."
  },
  {
   "start": 52.17,
   "end": 52.75,
   "text": "הם היו מתים",
   "emphasis": "מתים"
  },
  {
   "start": 52.75,
   "end": 54.01,
   "text": "על עישונים.",
   "emphasis": null
  },
  {
   "start": 54.01,
   "end": 55.915,
   "text": "והסחורה, בהשוואה להיום,",
   "emphasis": null
  },
  {
   "start": 55.915,
   "end": 57.895,
   "text": "הייתה זבל שבזבל.",
   "emphasis": "זבל"
  },
  {
   "start": 57.895,
   "end": 59.195,
   "text": "אני זוכר,",
   "emphasis": "זוכר,"
  },
  {
   "start": 59.195,
   "end": 60.385,
   "text": "היינו מוציאים ממנה",
   "emphasis": null
  },
  {
   "start": 60.385,
   "end": 61.78,
   "text": "זרעים שעות.",
   "emphasis": "זרעים"
  },
  {
   "start": 61.78,
   "end": 62.615,
   "text": "אבל זאת הייתה",
   "emphasis": null
  },
  {
   "start": 62.615,
   "end": 63.8,
   "text": "תקופה יפה.",
   "emphasis": "יפה."
  },
  {
   "start": 63.8,
   "end": 64.735,
   "text": "היינו כל היום",
   "emphasis": null
  },
  {
   "start": 64.735,
   "end": 65.645,
   "text": "מושכים באנגים,",
   "emphasis": "באנגים,"
  },
  {
   "start": 65.645,
   "end": 67.035,
   "text": "מעושנים.",
   "emphasis": null
  },
  {
   "start": 67.775,
   "end": 69.105,
   "text": "מטיילים בנתניה",
   "emphasis": "בנתניה"
  },
  {
   "start": 69.105,
   "end": 70.845,
   "text": "עם משקפי שמש.",
   "emphasis": null
  },
  {
   "start": 70.855,
