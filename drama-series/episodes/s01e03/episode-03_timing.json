  },
  {
   "start": 3.155,
   "end": 4.28,
   "text": "החלטתי שבא לי",
   "emphasis": null
  },
  {
   "start": 4.28,
   "end": 6.175,
   "text": "כל היום רק לעשן.",
   "emphasis": "לעשן."
  },
  {
   "start": 6.175,
   "end": 7.805,
   "text": "וזה מה שקרה.",
   "emphasis": "שקרה."
  },
  {
   "start": 8.005,
   "end": 8.66,
   "text": "בית ספר",
   "emphasis": null
  },
  {
   "start": 8.66,
   "end": 10.275,
   "text": "לא בא בחשבון.",
   "emphasis": "בחשבון."
  },
  {
   "start": 10.275,
   "end": 11.045,
   "text": "הייתי עובד",
   "emphasis": null
  },
  {
   "start": 11.045,
   "end": 11.98,
   "text": "בשתי עבודות,",
   "emphasis": "עבודות,"
  },
  {
   "start": 11.98,
   "end": 13.705,
   "text": "מהבוקר עד הערב.",
   "emphasis": "הערב."
  },
  {
   "start": 13.705,
   "end": 14.645,
   "text": "שליח פיצה",
   "emphasis": "שליח"
  },
  {
   "start": 14.645,
   "end": 16.445,
   "text": "ומוכר במכולת.",
   "emphasis": "במכולת."
  },
  {
   "start": 16.465,
   "end": 17.585,
   "text": "כסף?",
   "emphasis": "כסף?"
  },
  {
   "start": 17.615,
   "end": 18.735,
   "text": "לא הייתה בעיה.",
   "emphasis": "בעיה."
  },
  {
   "start": 18.735,
   "end": 20.615,
   "text": "היה לי המון כסף.",
   "emphasis": "המון"
  },
  {
   "start": 20.615,
   "end": 21.555,
   "text": "בגלל שעזבתי",
   "emphasis": null
  },
  {
   "start": 21.555,
   "end": 22.59,
   "text": "את בית הספר,",
   "emphasis": "הספר,"
  },
  {
   "start": 22.59,
   "end": 23.795,
   "text": "הייתי כל היום מסתובב",
   "emphasis": null
  },
  {
   "start": 23.795,
   "end": 25.45,
   "text": "עם אנשים מפוקפקים.",
   "emphasis": "מפוקפקים."
  },
  {
   "start": 25.45,
   "end": 26.755,
   "text": "מהמרים כל היום,",
   "emphasis": "מהמרים"
  },
  {
   "start": 26.755,
   "end": 28.575,
   "text": "עושים שודים קטנים.",
   "emphasis": "שודים"
  },
  {
   "start": 28.745,
   "end": 29.805,
   "text": "אז זה לא נראה לי",
   "emphasis": null
  },
  {
   "start": 29.805,
   "end": 31.205,
   "text": "כזה סיפור.",
   "emphasis": "סיפור."
  },
  {
   "start": 31.245,
   "end": 31.795,
   "text": "ואז חבר",
   "emphasis": null
  },
  {
   "start": 31.795,
   "end": 33.245,
   "text": "הכיר לי חבר׳ה שלו",
   "emphasis": null
  },
  {
   "start": 33.245,
   "end": 34.76,
   "text": "מצפון תל אביב.",
   "emphasis": "מצפון"
  },
  {
   "start": 34.76,
   "end": 35.435,
   "text": "הם שינו לי",
   "emphasis": null
  },
  {
   "start": 35.435,
   "end": 37.17,
   "text": "את החיים לגמרי.",
   "emphasis": "לגמרי."
  },
  {
   "start": 37.71,
   "end": 39.175,
   "text": "בדיוק באותה תקופה",
   "emphasis": null
  },
  {
   "start": 39.175,
   "end": 40.27,
   "text": "הוצאתי רישיון",
   "emphasis": "רישיון"
  },
  {
   "start": 40.27,
   "end": 40.88,
   "text": "וקניתי לי",
   "emphasis": null
  },
  {
   "start": 40.88,
   "end": 42.675,
   "text": "ב.מ.וו יפהפייה.",
   "emphasis": "ב.מ.וו"
  },
  {
   "start": 42.675,
   "end": 43.995,
   "text": "לא חדשה כל כך,",
   "emphasis": null
  },
  {
   "start": 43.995,
   "end": 45.915,
   "text": "אבל עשתה את העבודה.",
   "emphasis": "העבודה."
  },
  {
   "start": 46.255,
   "end": 47.295,
   "text": "והתחלתי להסתובב",
   "emphasis": null
  },
  {
   "start": 47.295,
   "end": 48.335,
   "text": "עם החבר׳ה האלה",
   "emphasis": null
  },
  {
   "start": 48.335,
   "end": 49.69,
   "text": "מצפון תל אביב.",
   "emphasis": "מצפון"
  },
  {
   "start": 49.69,
   "end": 50.825,
   "text": "הייתי מעביר להם",
   "emphasis": "מעביר"
  },
  {
   "start": 50.825,
   "end": 52.18,
   "text": "כמויות של גראס.",
   "emphasis": "גראס."
  },
  {
   "start": 52.18,
   "end": 52.825,
   "text": "הם היו מתים",
   "emphasis": "מתים"
  },
  {
   "start": 52.825,
   "end": 54.1,
   "text": "על עישונים.",
   "emphasis": null
  },
  {
   "start": 54.1,
   "end": 56.115,
   "text": "והסחורה, בהשוואה להיום,",
   "emphasis": null
  },
  {
   "start": 56.115,
   "end": 58.195,
   "text": "הייתה זבל שבזבל.",
   "emphasis": "זבל"
  },
  {
   "start": 58.195,
   "end": 59.285,
   "text": "אני זוכר,",
   "emphasis": "זוכר,"
  },
  {
   "start": 59.285,
   "end": 60.605,
   "text": "היינו מוציאים ממנה",
   "emphasis": null
  },
  {
   "start": 60.605,
   "end": 61.835,
   "text": "זרעים שעות.",
   "emphasis": "זרעים"
  },
  {
   "start": 61.835,
   "end": 62.725,
   "text": "אבל זאת הייתה",
   "emphasis": null
  },
  {
   "start": 62.725,
   "end": 63.77,
   "text": "תקופה יפה.",
   "emphasis": "יפה."
  },
  {
   "start": 63.77,
   "end": 64.725,
   "text": "היינו כל היום",
   "emphasis": null
  },
  {
   "start": 64.725,
   "end": 65.635,
   "text": "מושכים באנגים,",
   "emphasis": "באנגים,"
  },
  {
   "start": 65.635,
   "end": 67.005,
   "text": "מעושנים.",
   "emphasis": null
  },
  {
   "start": 67.745,
   "end": 69.035,
   "text": "מטיילים בנתניה",
   "emphasis": "בנתניה"
  },
  {
   "start": 69.035,
   "end": 70.4,
   "text": "עם משקפי שמש.",
   "emphasis": null
  },
  {
   "start": 70.4,
   "end": 71.725,
   "text": "בלי צרות.",
   "emphasis": "צרות."
  },
  {
   "start": 71.725,
