 "captions": [
  {
   "start": 0.76,
   "end": 2.42,
   "text": "היי, נעים מאוד.",
   "emphasis": "מאוד."
  },
  {
   "start": 2.42,
   "end": 3.22,
   "text": "אני דין,",
   "emphasis": "דין,"
  },
  {
   "start": 3.22,
   "end": 4.63,
   "text": "והחיים שלי סובבים",
   "emphasis": "סובבים"
  },
  {
   "start": 4.63,
   "end": 6.07,
   "text": "סביב הירוק.",
   "emphasis": "הירוק."
  },
  {
   "start": 6.56,
   "end": 7.23,
   "text": "הכול התחיל",
   "emphasis": "התחיל"
  },
  {
   "start": 7.23,
   "end": 9.5,
   "text": "בשנות התשעים, בנתניה.",
   "emphasis": "התשעים,"
  },
  {
   "start": 9.5,
   "end": 10.81,
   "text": "שם גדלתי.",
   "emphasis": "גדלתי."
  },
  {
   "start": 10.81,
   "end": 11.93,
   "text": "גדלנו בתקופה",
   "emphasis": null
  },
  {
   "start": 11.93,
   "end": 13.17,
   "text": "הכי טובה שיש.",
   "emphasis": "טובה"
  },
  {
   "start": 13.17,
   "end": 14.67,
   "text": "היינו נתלים על עצים,",
   "emphasis": "נתלים"
  },
  {
   "start": 14.67,
   "end": 16.005,
   "text": "גונבים מסטיקים,",
   "emphasis": "גונבים"
  },
  {
   "start": 16.005,
   "end": 17.16,
   "text": "פורצים לבר,",
   "emphasis": "פורצים"
  },
  {
   "start": 17.16,
   "end": 19.32,
   "text": "ורק עושים שטויות כל היום.",
   "emphasis": "שטויות"
  },
  {
   "start": 19.32,
   "end": 20.275,
   "text": "מכות?",
   "emphasis": "מכות?"
  },
  {
   "start": 20.275,
   "end": 21.99,
   "text": "כן, היינו גם הולכים",
   "emphasis": "הולכים"
  },
  {
   "start": 21.99,
   "end": 23.215,
   "text": "מכות כל היום.",
   "emphasis": "מכות"
  },
  {
   "start": 23.215,
   "end": 24.825,
   "text": "יותר נכון…",
   "emphasis": "נכון…"
  },
  {
   "start": 24.85,
   "end": 26.38,
   "text": "מקבלים מכות.",
   "emphasis": "מקבלים"
  },
  {
   "start": 26.38,
   "end": 27.99,
   "text": "אה, ודרך אגב,",
   "emphasis": "אגב,"
  },
  {
   "start": 27.99,
   "end": 29.645,
   "text": "זה החבר הכי טוב שלי,",
   "emphasis": "טוב"
  },
  {
   "start": 29.645,
   "end": 30.715,
   "text": "שלב.",
   "emphasis": "שלב."
  },
  {
   "start": 30.715,
   "end": 32.77,
   "text": "היום שלב חזר בתשובה.",
   "emphasis": "היום"
  },
  {
   "start": 32.77,
   "end": 33.9,
   "text": "הוא רב מצליח,",
   "emphasis": "מצליח,"
  },
  {
   "start": 33.9,
   "end": 35.67,
   "text": "ואני די גאה בו.",
   "emphasis": "גאה"
  },
  {
   "start": 35.71,
   "end": 37.24,
   "text": "ההיכרות הראשונה שלי",
   "emphasis": "הראשונה"
  },
  {
   "start": 37.24,
   "end": 38.14,
   "text": "עם הירוק…",
   "emphasis": "הירוק…"
  },
  {
   "start": 38.14,
   "end": 39.38,
   "text": "יותר נכון,",
   "emphasis": null
  },
  {
   "start": 39.38,
   "end": 40.42,
   "text": "חום…",
   "emphasis": "חום…"
  },
  {
   "start": 40.42,
   "end": 43.04,
   "text": "הייתה בבית נטוש ומסריח.",
   "emphasis": "נטוש"
  },
  {
   "start": 43.04,
   "end": 45.105,
   "text": "ישבנו שם כמה חברים.",
   "emphasis": "חברים."
  },
  {
   "start": 45.105,
   "end": 46.13,
   "text": "הם נתנו לי לעשן",
   "emphasis": "לעשן"
  },
  {
   "start": 46.13,
   "end": 46.59,
   "text": "באנג",
   "emphasis": "באנג"
  },
  {
   "start": 46.59,
   "end": 48.065,
   "text": "בפעם הראשונה.",
   "emphasis": "הראשונה."
  }
 ],
