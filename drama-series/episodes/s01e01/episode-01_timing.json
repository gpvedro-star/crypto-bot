 "captions": [
  {
   "start": 0.76,
   "end": 2.355,
   "text": "היי, נעים מאוד.",
   "emphasis": "מאוד."
  },
  {
   "start": 2.355,
   "end": 3.245,
   "text": "אני דין,",
   "emphasis": "דין,"
  },
  {
   "start": 3.245,
   "end": 4.72,
   "text": "והחיים שלי סובבים",
   "emphasis": "סובבים"
  },
  {
   "start": 4.72,
   "end": 6.215,
   "text": "סביב הירוק.",
   "emphasis": "הירוק."
  },
  {
   "start": 6.705,
   "end": 7.505,
   "text": "הכול התחיל",
   "emphasis": "התחיל"
  },
  {
   "start": 7.505,
   "end": 9.78,
   "text": "בשנות התשעים, בנתניה.",
   "emphasis": "התשעים,"
  },
  {
   "start": 9.78,
   "end": 11.1,
   "text": "שם גדלתי.",
   "emphasis": "גדלתי."
  },
  {
   "start": 11.1,
   "end": 12.365,
   "text": "גדלנו בתקופה",
   "emphasis": null
  },
  {
   "start": 12.365,
   "end": 13.86,
   "text": "הכי טובה שיש.",
   "emphasis": "טובה"
  },
  {
   "start": 13.86,
   "end": 15.525,
   "text": "היינו נתלים על עצים,",
   "emphasis": "נתלים"
  },
  {
   "start": 15.525,
   "end": 16.83,
   "text": "גונבים מסטיקים,",
   "emphasis": "גונבים"
  },
  {
   "start": 16.83,
   "end": 18.015,
   "text": "פורצים לבר,",
   "emphasis": "פורצים"
  },
  {
   "start": 18.015,
   "end": 20.225,
   "text": "ורק עושים שטויות כל היום.",
   "emphasis": "שטויות"
  },
  {
   "start": 20.225,
   "end": 21.235,
   "text": "מכות?",
   "emphasis": "מכות?"
  },
  {
   "start": 21.235,
   "end": 23.045,
   "text": "כן, היינו גם הולכים",
   "emphasis": "הולכים"
  },
  {
   "start": 23.045,
   "end": 24.29,
   "text": "מכות כל היום.",
   "emphasis": "מכות"
  },
  {
   "start": 24.29,
   "end": 25.71,
   "text": "יותר נכון…",
   "emphasis": "נכון…"
  },
  {
   "start": 25.89,
   "end": 27.62,
   "text": "מקבלים מכות.",
   "emphasis": "מקבלים"
  },
  {
   "start": 27.62,
   "end": 29.165,
   "text": "אה, ודרך אגב,",
   "emphasis": "אגב,"
  },
  {
   "start": 29.165,
   "end": 30.935,
   "text": "זה החבר הכי טוב שלי,",
   "emphasis": "טוב"
  },
  {
   "start": 30.935,
   "end": 32.02,
   "text": "שלב.",
   "emphasis": "שלב."
  },
  {
   "start": 32.02,
   "end": 34.4,
   "text": "היום שלב חזר בתשובה.",
   "emphasis": "היום"
  },
  {
   "start": 34.4,
   "end": 35.67,
   "text": "הוא רב מצליח,",
   "emphasis": "מצליח,"
  },
  {
   "start": 35.67,
   "end": 37.6,
   "text": "ואני די גאה בו.",
   "emphasis": "גאה"
  },
  {
   "start": 37.64,
   "end": 39.12,
   "text": "ההיכרות הראשונה שלי",
   "emphasis": "הראשונה"
  },
  {
   "start": 39.12,
   "end": 40.23,
   "text": "עם הירוק…",
   "emphasis": "הירוק…"
  },
  {
   "start": 40.23,
   "end": 41.5,
   "text": "יותר נכון,",
   "emphasis": null
  },
  {
   "start": 41.5,
   "end": 42.59,
   "text": "חום…",
   "emphasis": "חום…"
  },
  {
   "start": 42.59,
   "end": 45.44,
   "text": "הייתה בבית נטוש ומסריח.",
   "emphasis": "נטוש"
  },
  {
   "start": 45.44,
   "end": 47.58,
   "text": "ישבנו שם כמה חברים.",
   "emphasis": "חברים."
  },
  {
   "start": 47.58,
   "end": 48.73,
   "text": "הם נתנו לי לעשן",
   "emphasis": "לעשן"
  },
  {
   "start": 48.73,
   "end": 49.09,
   "text": "באנג",
   "emphasis": "באנג"
  },
  {
   "start": 49.09,
   "end": 50.16,
   "text": "בפעם הראשונה.",
   "emphasis": "הראשונה."
  }
 ],
