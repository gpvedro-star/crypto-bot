# DynaTech AI Studio — environment configuration.
# Copy to .env.local and fill in. NEVER commit real keys. Keys are read server-side only.

# --- LLM providers (at least one recommended; with none, agents use the built-in
#     deterministic knowledge base, which is fully functional but less tailored) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
# Which provider agents prefer: anthropic | openai | offline  (default: first one configured)
LLM_PROVIDER=

# --- Media ---
PEXELS_API_KEY=

# --- Video generation (optional; provider is disabled until configured) ---
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_MODEL_PATH=

# --- Studio ---
# Where project memory + generated sites are stored
STUDIO_PROJECTS_DIR=./projects
