# DynaTech AI Studio — environment configuration (placeholders only).
# Copy this file to .env.local (git-ignored) and fill in the values. NEVER commit real keys.
# Keys are read server-side only and are never sent to the browser.

# ─── LLM ────────────────────────────────────────────────────────────────────────
# Which provider the agents use: anthropic (default) | openai | offline.
# Unset = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if fully configured, else demo mode.
LLM_PROVIDER=

# Anthropic (default provider)
ANTHROPIC_API_KEY=
# Model id. Default: claude-opus-5-5
ANTHROPIC_MODEL=
# Reasoning effort: low | medium | high (default) | xhigh | max | off
ANTHROPIC_EFFORT=
# Server-side refusal fallback (recommended by Anthropic for this model family): on (default) | off
ANTHROPIC_REFUSAL_FALLBACK=
# Max output tokens per call (default 32000)
ANTHROPIC_MAX_TOKENS=

# OpenAI (used when LLM_PROVIDER=openai, or when only OpenAI is configured). No default model: set one explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=

# ─── Media ──────────────────────────────────────────────────────────────────────
# Real photo + video search. Without it the Studio runs in demo mode with labelled placeholders.
PEXELS_API_KEY=

# ─── Video generation (optional; ALWAYS asks for approval before spending credits) ─────
# Credentials, either as one value  HF_KEY=<api_key>:<api_secret>  or as two values:
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Text-to-video model route from your Higgsfield dashboard, e.g. vendor/model/version/text-to-video (required)
HIGGSFIELD_MODEL_PATH=
# Extra JSON arguments for that model, e.g. {"resolution":"1080p"} (optional)
HIGGSFIELD_EXTRA_ARGS=
# Polling interval and overall limit for a generation job (defaults: 10000 ms, 900000 ms)
HIGGSFIELD_POLL_INTERVAL_MS=
HIGGSFIELD_TIMEOUT_MS=
# Largest video file (MB) the Studio will download and accept (default 25)
VIDEO_MAX_MB=

# ─── Studio ─────────────────────────────────────────────────────────────────────
# 1 = refuse to run unless a real LLM and Pexels are configured (no demo output, no placeholders)
STUDIO_REQUIRE_REAL=
# 1 = build the generated site and inspect it in headless Chromium during QA
STUDIO_BROWSER_QA=
# Where project memory + generated sites are stored (default ./projects)
STUDIO_PROJECTS_DIR=
